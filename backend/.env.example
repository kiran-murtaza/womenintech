# ─────────────────────────────────────────────────────────────
# Women in Tech Backend — Environment Variables
# ─────────────────────────────────────────────────────────────

# Google AI Studio API key (required for Gemini bill processing)
GEMINI_API_KEY=your-google-ai-studio-api-key-here

# Gemini model to use (optional; GEMINI_MODEL takes precedence over MODEL_NAME)
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alias for deployments that configure MODEL_NAME
MODEL_NAME=gemini-3.1-flash-lite

# Backend server port (optional — defaults to 4000)
PORT=4000

# Frontend URL for CORS (optional — defaults to http://localhost:3000)
FRONTEND_URL=http://localhost:3000
